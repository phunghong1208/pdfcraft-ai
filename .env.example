# Workspace AI — dùng proxy cùng origin để tránh CORS (curl/Postman gọi thẳng IP vẫn OK)
NEXT_PUBLIC_WORKSPACE_AI_URL=/api/workspace-ai
# Target cho dev proxy (src/app/api/workspace-ai/.../route.ts)
AI_SERVER_UPSTREAM=http://192.168.1.90:8338
# Timeout proxy (ms) — tóm tắt PDF ~50–120s
AI_PROXY_TIMEOUT_MS=600000

# Hoặc gọi thẳng (cần server bật CORS Access-Control-Allow-Origin):
# NEXT_PUBLIC_WORKSPACE_AI_URL=http://192.168.1.90:8338

NEXT_PUBLIC_AI_API_URL=https://your-ai-server.com
